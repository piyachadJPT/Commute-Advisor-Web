{
  "name": "commute_advisor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/gen-icons.mjs",
    "db:types": "supabase gen types typescript --schema public > src/lib/database.types.ts && prettier --write src/lib/database.types.ts",
    "db:reset": "supabase db reset",
    "test": "vitest run",
    "test:db": "vitest run tests/db",
    "dev:user": "node scripts/dev-user.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "next-intl": "4.14.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "0.48.3",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "5.1.0"
  }
}
