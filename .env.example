# Copy to .env.local and fill in. Never commit real keys.
#
# Local stack (supabase start): run `supabase status -o env` and use
#   NEXT_PUBLIC_SUPABASE_URL=<API_URL>
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<PUBLISHABLE_KEY>
# Hosted project: Dashboard -> Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Jobs and the backfill script. Never expose with a NEXT_PUBLIC_ name.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Each is `openssl rand -hex 32`. JOB_SECRET must equal the `job_secret` in Supabase Vault.
JOB_SECRET=
CRON_SECRET=

# Web Push. Generate once with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
