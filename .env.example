# Copy to .env.local and fill in. Never commit real keys.
#
# Local stack (supabase start): run `supabase status -o env` and use
#   NEXT_PUBLIC_SUPABASE_URL=<API_URL>
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<PUBLISHABLE_KEY>
# Hosted project: Dashboard → Project Settings → API Keys → publishable key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
